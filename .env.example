# ==============================================================================
# xl-sandboxed-opencode Configuration Template
# ==============================================================================
# IMPORTANT: You MUST copy this file to a new '.env' file in this same directory
# before starting the sandbox (e.g., run `cp .env.example .env`).
# Ensure you configure the absolute paths below correctly.
# ==============================================================================

PROJECT_NAME=default_project
PROJECTS_ROOT_PATH=/absolute/path/to/sandboxed-projects
SHARED_SYSTEM_PATH=/absolute/path/to/read-only-shared
TEMP_PATH=/absolute/path/to/sandbox-temp

HOST_UID=1000
HOST_GID=1000

GIT_USERNAME="Agent Coder"
GIT_EMAIL=agent@sandboxed.local

# Optional: expose a GitHub token to gh without writing it into project files.
# Prefer a fine-grained token with the minimum repository permissions required.
GITHUB_TOKEN=
GH_TOKEN=

PYTHON_BASE_IMAGE=python:3.13.15-slim-bookworm
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.13
NODE_MAJOR=22
NODE_VERSION=22.23.2-1nodesource1
OPENCODE_VERSION=1.18.30
GH_VERSION=2.100.0
GH_AMD64_SHA256=698c8d88cc19cc92bfe96bad58d10b2a5b274c52433d6dc57799c81f6139d5fc
GH_ARM64_SHA256=33ccd2ad7ce639c927e1cb209e36555b0e1fbb89f7a38239c0568040ec758612

# --- Model Profiles & LLM Routing ---
# Select a model profile from config/model_profiles/ (e.g. gemma-4-e4b, qwen-3.5-9b, qwen-3-4b).
# When MODEL_PROFILE is set, it overrides manual provider/model combinations.
MODEL_PROFILE=gemma-4-e4b

# LLM host: "host.docker.internal" (same machine) or explicit LAN IP (e.g. 192.168.1.3).
LLM_HOST=192.168.1.3
LLM_SOURCE=lm_studio
# LLM_PORT default depends on LLM_SOURCE: lm_studio=1234, fastflow_amd=52625, ollama_docker=11434.
LLM_PORT=1234
LM_STUDIO_MODEL=google/gemma-4-e4b
# Optional Bearer token when LM Studio "Require Authentication" is enabled.
LM_STUDIO_API_KEY=
FASTFLOW_MODEL=
OLLAMA_MODEL=qwen3:4b
# Ollama: how long to keep model loaded after last request (e.g. 5m, 1h, 0 for immediate unload).
OLLAMA_KEEP_ALIVE=5m
# Ollama: number of GPU layers to offload (999=all available, 0=CPU only).
OLLAMA_NUM_GPU=999

# --- Sampling & Context Tuning (Gemma 4 E4B Defaults) ---
TEMPERATURE=0.2
TOP_P=0.95
TOP_K=40
MAX_CONTEXT_LENGTH=131072

OPENCODE_PORT=3000
APP_PORT=7860
WORKSPACE_MEMORY_LIMIT=8g
WORKSPACE_CPUS=4
OLLAMA_IMAGE_TAG=0.34.0

# --- Interface & Operation Mode ---
# "web": browser UI (default). "tui": terminal UI (use `make run-tui`).
OPENCODE_INTERFACE=web

# "interactive": user-driven (default). OpenCode web UI will run on OPENCODE_PORT (e.g. localhost:3000).
# "autonomous": execute TASK_FILE end-to-end and exit. Output goes to logs/autonomous.log.
# "conductor": a frontier AI agent orchestrates the local agent via MCP bridge.
#              NOTE: Conductor mode runs OpenCode headlessly on internal port 4096 and starts
#              the MCP bridge on MCP_BRIDGE_PORT (default 8443). The web UI on OPENCODE_PORT
#              will not be available in this mode.
OPERATION_MODE=interactive

# Conductor mode: port for the MCP bridge server that the external AI agent connects to.
MCP_BRIDGE_PORT=8443
# Path to project spec markdown file (relative to project root). Required when OPERATION_MODE=autonomous.
TASK_FILE=

# --- MCP Servers ---
# Path to MCP server config JSON file (relative to repo root, project, or shared mount).
# Merged into opencode.json under the "mcp" key. See config/mcp-example.json for format.
MCP_CONFIG_FILE=

# --- Security & Hardening ---
# Network egress: "restricted" (LLM-only, no internet) or "full" (current default).
# To use restricted mode, switch workspace network to agent_network_restricted in compose.
NETWORK_EGRESS=restricted
# Custom seccomp profile. Set to "unconfined" to disable syscall filtering.
SECCOMP_PROFILE=config/seccomp-workspace.json
# Expanded secret pattern detection (AWS keys, private keys, JWT, Slack tokens).
SECRET_SCAN_STRICT=true

# --- Healthchecks ---
HEALTHCHECK_INTERVAL=30s

# --- Logging ---
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# --- Resource Limits ---
ULIMIT_NOFILE=4096
ULIMIT_NPROC=256

# --- Runtime Monitoring (opt-in) ---
PORTSCAN_ENABLED=false
PORTSCAN_INTERVAL=300
RESOURCE_MONITOR_ENABLED=false
RESOURCE_MONITOR_INTERVAL=60
AUTOLOG_ENABLED=false

# --- Dashboard (opt-in, web/autonomous mode only) ---
# Static HTML dashboard served on a separate port. Reads monitoring JSONL logs.
DASHBOARD_ENABLED=false
DASHBOARD_PORT=8080
DASHBOARD_REFRESH_INTERVAL=30
